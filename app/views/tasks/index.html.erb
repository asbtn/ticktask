<div class="mx-auto p-8 max-w-4xl container">
  <%= render "form" %>

  <div
    id="tasks-container"
    class="
      space-y-2 bg-primary-content shadow-lg mt-4 p-4 rounded-xl h-96 md:h-[500px]
      overflow-y-auto scrollbar-thin scrollbar-thumb-primary scrollbar-track-base-200
    "
  >
    <% if @tasks.any? %>
      <%= render @tasks %>
    <% else %>
      <div class="opacity-50 py-12 text-center">
        <p class="text-xl">No tasks yet</p>
        <p>Add one above to get started!</p>
      </div>
    <% end %>
  </div>
</div>
