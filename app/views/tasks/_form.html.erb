<div class="bg-base-100 shadow-lg mb-6 card">
  <div class="p-4 card-body">
    <%= form_with model: [@user, Task.new], local: true, class: "space-y-3" do |form| %>
      <div class="flex flex-row items-center gap-3">
        <%= form.check_box :completed,
                       class: "checkbox checkbox-primary flex-shrink-0",
                       data: {
                         action: "change->task#toggleCompleted",
                       } %>
        <%= form.text_field :title,
                        placeholder: "Task title",
                        class: "input input-bordered flex-1 min-w-0",
                        required: true %>
        <%= form.datetime_local_field :due_at,
                                  class: "input input-bordered w-50 flex-shrink-0" %>
      </div>
    <% end %>
  </div>
</div>
