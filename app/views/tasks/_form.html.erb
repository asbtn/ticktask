<div class="bg-base-100 shadow-lg mb-6 card">
  <div class="p-4 card-body">
    <%= form_with model: [@user, Task.new], local: true, class: "space-y-3" do |form| %>
      <div class="flex flex-row items-center gap-3">
        <%= form.text_field :description,
                        placeholder: "Task title",
                        class: "input input-bordered flex-1 min-w-0 outline-none",
                        required: true %>
        <%= form.submit "+",
                    class:
                      "btn btn-circle btn-primary text-primary-content hover:bg-accent hover:text-accent-content border-none btn-sm flex-shrink-0 h-10 w-10 p-0 shadow-sm",
                    title: "Add task" %>
      </div>
    <% end %>
  </div>
</div>
